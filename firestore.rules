rules_version = '2';

// Regras do Firestore para o R.H.S
// Qualquer visitante PODE LER (o site precisa mostrar as comunidades pra todo mundo).
// Só um administrador autenticado (Firebase Authentication) PODE ESCREVER.
// Exceção: "visitas" (contador de acesso) e "denuncias" podem ser criadas por
// qualquer visitante — mas só o admin pode ler/editar denúncias.

service cloud.firestore {
  match /databases/{database}/documents {

    match /comunidades/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /aliados/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /admins/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /config/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /visitas/{id} {
      allow read: if request.auth != null;
      allow write: if true; // qualquer visitante registra presença anônima
    }

    match /denuncias/{id} {
      allow create: if true;      // qualquer visitante pode denunciar
      allow read, update, delete: if request.auth != null;
    }
  }
}
